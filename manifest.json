{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "0.2.1",
  "default_locale": "en",
  "homepage_url": "https://pathadd.com/",
  "description": "__MSG_extensionDescription__",
  "minimum_chrome_version": "113",
  "permissions": ["contextMenus", "storage"],
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" },
    "default_popup": "popup.html"
  },
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob:; media-src 'self' https://pathadd.com; connect-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'"
  }
}
